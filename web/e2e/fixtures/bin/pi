#!/usr/bin/env node
// Fake `pi` coding agent for the end-to-end workbench test. It implements just
// enough of pi's documented `--mode json` protocol to drive one prompt: a
// session header, a streamed assistant reply in two text deltas, and the
// closing message/agent records. It never touches the network or the
// filesystem, so the platform's pi adapter can be exercised without the real
// CLI installed.
//
// Invoked as: pi --mode json [--session-id ID] [-- ...prompt]
// It also answers `--version` (prints a version inside the adapter's tested
// range) and fails on demand: a prompt containing __e2e_fail__ makes the
// process write one stderr diagnostic and exit non-zero, which the e2e
// failure spec uses to prove one backend's error never affects another.
'use strict'

const sleep = (ms) => new Promise((resolve) => setTimeout(resolve, ms))

function valueAfter(flag) {
  const index = process.argv.indexOf(flag)
  return index >= 0 ? process.argv[index + 1] ?? '' : ''
}

function write(record) {
  process.stdout.write(`${JSON.stringify(record)}\n`)
}

// `--version` support for the platform's diagnostics probe.
if (process.argv.includes('--version')) {
  process.stdout.write('1.1.0-mock\n')
  process.exit(0)
}

// `--list-models` support for the workbench's model picker. The platform parses
// the header row and the provider/model columns.
if (process.argv.includes('--list-models')) {
  process.stdout.write('provider model context max-out thinking images\n')
  process.stdout.write('pi pi-model 128k 8k no no\n')
  process.exit(0)
}

async function main() {
  const sessionId = valueAfter('--session-id')
  const separator = process.argv.indexOf('--')
  const prompt = separator >= 0 ? process.argv[separator + 1] ?? '' : ''
  const cwd = process.cwd()
  const reply = `pi reply: ${prompt}`

  // On-demand failure used by agent-failures.spec.ts: a stderr diagnostic and
  // a non-zero exit, like a provider the CLI cannot reach.
  if (prompt.includes('__e2e_fail__')) {
    process.stderr.write('provider unavailable: no credentials configured (fake failure)\n')
    process.exit(1)
  }

  write({ type: 'session', id: sessionId, cwd })
  write({ type: 'agent_start' })
  write({ type: 'message_start', message: { role: 'user', content: prompt } })

  // Hold the turn open until the platform interrupts (kills) this process, so
  // the workbench's stop action can be observed deterministically.
  if (prompt.includes('__e2e_hold__')) {
    await new Promise(() => {})
  }

  const split = Math.ceil(reply.length / 2)
  await sleep(15)
  write({
    type: 'message_update',
    assistantMessageEvent: { type: 'text_delta', delta: reply.slice(0, split) },
  })
  await sleep(15)
  write({
    type: 'message_update',
    assistantMessageEvent: { type: 'text_delta', delta: reply.slice(split) },
  })
  write({
    type: 'message_end',
    message: { role: 'assistant', content: [{ type: 'text', text: reply }] },
  })
  write({ type: 'agent_end' })
}

main().catch((error) => {
  process.stderr.write(`fake pi: ${error && error.stack ? error.stack : error}\n`)
  process.exit(1)
})
