#!/usr/bin/env node
// Mock opencode v2 server for the end-to-end workbench test. It implements the
// minimal HTTP surface the platform's opencode adapter consumes:
//
//   GET  /api/info                       readiness probe
//   GET  /api/session?directory=…        list sessions
//   POST /api/session                    create a native session
//   GET  /api/session/:id                fetch one session
//   POST /api/session/:id/model          model switch (accepted)
//   POST /api/session/:id/prompt         admit a turn and stream its reply
//   GET  /api/session/:id/message         the session's native message log
//   GET  /api/event                      SSE event stream
//
// Every request is basic-auth protected with the generated credentials the
// adapter passes via OPENCODE_SERVER_PASSWORD. The streamed reply is emitted as
// session.created + two session.text.delta chunks + session.text.ended so the
// adapter normalizes it into the platform's message events.
//
// Invoked as: opencode serve --hostname H --port P
// In `opencode serve --service` mode it behaves like the real machine-wide
// service: it generates its own credential and registers itself in
// $XDG_STATE_HOME/opencode/service.json, which the platform only ever reads.
// It also answers `--version` for the platform's diagnostics probe (a version
// inside the adapter's tested range) and reports the same version on
// /api/info, so the API check classifies the mock as the version it mimics.
'use strict'

import http from 'node:http'
import crypto from 'node:crypto'
import fs from 'node:fs'
import os from 'node:os'
import path from 'node:path'

// `--version` support for the platform's diagnostics probe.
if (process.argv.includes('--version')) {
  process.stdout.write('opencode v2.0.24-mock\n')
  process.exit(0)
}

function flagValue(name, fallback) {
  const index = process.argv.indexOf(name)
  return index >= 0 ? process.argv[index + 1] : fallback
}

const host = flagValue('--hostname', '127.0.0.1')
const port = Number.parseInt(flagValue('--port', '0'), 10)
// `serve --service` is how the real opencode runs one machine-wide service:
// it generates its own credential and publishes it, with its url and pid, in
// $XDG_STATE_HOME/opencode/service.json. The platform only reads that file —
// so the mock has to publish it, exactly as the real binary does.
const serviceMode = process.argv.includes('--service')
const serviceId = crypto.randomUUID()
const password = process.env.OPENCODE_SERVER_PASSWORD || (serviceMode ? crypto.randomBytes(12).toString('hex') : '')
const directory = process.cwd()
const version = '2.0.24-mock'

const sessions = new Map()
// messages mirrors the real server's machine-wide message storage. The real
// opencode keeps session data on disk, so any running server reads any
// session's history — the platform relies on that when it replays a session
// whose own instance is gone. Keeping this in memory would make the mock
// stricter than the thing it stands in for, and would fail a correct platform.
const storeRoot = process.env.OPENCODE_MOCK_STORE_DIR || path.join(os.tmpdir(), 'opencode-mock-store')
const pending = new Map()
const clients = new Set()
// Every event is retained so a stream that connects after a prompt still
// receives it; the workbench test often subscribes just after creating a
// session, and the adapter's single stream should not miss an early turn.
const history = []
let sequence = 0

function sendJSON(response, status, body) {
  const payload = body === undefined ? '' : JSON.stringify(body)
  response.writeHead(status, { 'content-type': 'application/json' })
  response.end(payload)
}

function sendSSE(response, event) {
  response.write(`data: ${JSON.stringify(event)}\n\n`)
}

function broadcast(event) {
  history.push(event)
  for (const client of clients) sendSSE(client, event)
}

function authorized(request) {
  const header = request.headers.authorization || ''
  const match = /^Basic (.+)$/.exec(header)
  if (!match) return false
  const [user, pass] = Buffer.from(match[1], 'base64').toString().split(':')
  return user === 'opencode' && pass === password
}

function readBody(request) {
  return new Promise((resolve) => {
    const chunks = []
    request.on('data', (chunk) => chunks.push(chunk))
    request.on('end', () => {
      const raw = Buffer.concat(chunks).toString('utf8').trim()
      if (raw === '') return resolve({})
      try {
        resolve(JSON.parse(raw))
      } catch {
        resolve({})
      }
    })
  })
}

// sessionDirectory is the working directory one session belongs to. One
// machine-wide service serves every project, so a session's own directory —
// not the server's — is what the platform filters events and listings by.
function sessionDirectory(id) {
  return sessions.get(id)?.directory || directory
}

function sessionInfo(id) {
  return {
    id,
    projectID: 'mock-project',
    title: sessions.get(id)?.title || '',
    location: { directory: sessionDirectory(id) },
    time: { created: sessions.get(id)?.created || Date.now(), updated: Date.now() },
  }
}

// messageStorePath is one session's message log, scoped by the session's
// working directory the way the real server scopes its per-project data.
function messageStorePath(sessionId) {
  const slug = sessionDirectory(sessionId).replace(/^[/\\]+/, '').replace(/[/\\:]/g, '-')
  return path.join(storeRoot, slug, `${sessionId}.json`)
}

// readMessages returns a session's native message log as the real server's
// /message endpoint does: user entries carry a top-level text, assistant
// entries a content block array.
function readMessages(sessionId) {
  try {
    return JSON.parse(fs.readFileSync(messageStorePath(sessionId), 'utf8'))
  } catch {
    return []
  }
}

// recordMessage appends one native message to a session's log.
function recordMessage(id, message) {
  const list = readMessages(id)
  list.push({
    id: `msg-${crypto.randomBytes(4).toString('hex')}`,
    time: { created: Date.now() },
    ...message,
  })
  const file = messageStorePath(id)
  fs.mkdirSync(path.dirname(file), { recursive: true })
  fs.writeFileSync(file, JSON.stringify(list))
}

function createdEvent(id, title) {
  sequence += 1
  return {
    id: `evt-${sequence}`,
    type: 'session.created',
    location: { directory: sessionDirectory(id) },
    data: { sessionID: id, title },
    durable: { aggregateID: id, seq: sequence, version: 1 },
  }
}

// executionEvent carries a turn lifecycle state (started / succeeded /
// interrupted) so the platform derives the session's turn.
function executionEvent(id, state) {
  sequence += 1
  return {
    id: `evt-${sequence}`,
    type: `session.execution.${state}`,
    location: { directory: sessionDirectory(id) },
    data: { sessionID: id },
    durable: { aggregateID: id, seq: sequence, version: 1 },
  }
}

function promptEvents(id, text) {
  const events = []
  const reply = `opencode reply: ${text}`
  // All records of one assistant message share its id so the adapter can close
  // the delta set without duplicating the streamed text.
  const messageId = `msg-${crypto.randomBytes(4).toString('hex')}`
  const reasoningId = `rs-${crypto.randomBytes(4).toString('hex')}`
  const reasoning = 'internal reasoning is not conversation'

  // The reasoning family streams before the text family, like the real server.
  sequence += 1
  events.push({
    id: `evt-${sequence}`,
    type: 'session.reasoning.started',
    location: { directory: sessionDirectory(id) },
    data: { sessionID: id, assistantMessageID: messageId, reasoningID: reasoningId, ordinal: 1 },
  })
  const reasoningSplit = Math.ceil(reasoning.length / 2)
  for (const chunk of [reasoning.slice(0, reasoningSplit), reasoning.slice(reasoningSplit)]) {
    sequence += 1
    events.push({
      id: `evt-${sequence}`,
      type: 'session.reasoning.delta',
      location: { directory: sessionDirectory(id) },
      data: { sessionID: id, assistantMessageID: messageId, reasoningID: reasoningId, delta: chunk },
    })
  }
  sequence += 1
  events.push({
    id: `evt-${sequence}`,
    type: 'session.reasoning.ended',
    location: { directory: sessionDirectory(id) },
    data: { sessionID: id, assistantMessageID: messageId, reasoningID: reasoningId, text: reasoning },
  })

  sequence += 1
  events.push({
    id: `evt-${sequence}`,
    type: 'session.text.started',
    location: { directory: sessionDirectory(id) },
    data: { sessionID: id, assistantMessageID: messageId },
  })
  const split = Math.ceil(reply.length / 2)
  for (const chunk of [reply.slice(0, split), reply.slice(split)]) {
    sequence += 1
    events.push({
      id: `evt-${sequence}`,
      type: 'session.text.delta',
      location: { directory: sessionDirectory(id) },
      data: { sessionID: id, assistantMessageID: messageId, delta: chunk },
    })
  }
  sequence += 1
  events.push({
    id: `evt-${sequence}`,
    type: 'session.text.ended',
    location: { directory: sessionDirectory(id) },
    data: { sessionID: id, assistantMessageID: messageId, text: reply },
  })
  return events
}

const server = http.createServer(async (request, response) => {
  const url = new URL(request.url, `http://${host}:${port}`)
  if (!authorized(request)) {
    sendJSON(response, 401, { _tag: 'unauthorized', message: 'authentication required' })
    return
  }

  // Event stream: keep the connection open until the process is stopped.
  if (request.method === 'GET' && url.pathname === '/api/event') {
    response.writeHead(200, {
      'content-type': 'text/event-stream',
      'cache-control': 'no-cache',
      connection: 'keep-alive',
    })
    response.write(': connected\n\n')
    for (const event of history) sendSSE(response, event)
    clients.add(response)
    request.on('close', () => clients.delete(response))
    return
  }

  if (request.method === 'GET' && url.pathname === '/api/info') {
    sendJSON(response, 200, {
      version,
      pid: process.pid,
      urls: [`http://${host}:${port}`],
      paths: { tmp: '/tmp' },
    })
    return
  }

  if (request.method === 'GET' && url.pathname === '/api/session') {
    // A machine-wide service holds every project's sessions; the caller's
    // ?directory= is what scopes a listing, exactly as the real server does.
    const wanted = url.searchParams.get('directory')
    const list = [...sessions.keys()]
      .filter((id) => !wanted || sessionDirectory(id) === wanted)
      .map(sessionInfo)
    sendJSON(response, 200, { data: list })
    return
  }

  // Model list for the workbench's composer. The adapter maps providerID + id
  // into the platform's provider/model form.
  if (request.method === 'GET' && url.pathname === '/api/model') {
    sendJSON(response, 200, {
      data: [
        { id: 'model-a', modelID: 'model-a', providerID: 'mock', name: 'Mock Model A' },
        {
          id: 'model-b',
          modelID: 'model-b',
          providerID: 'mock',
          name: 'Mock Model B',
          variants: [{ id: 'fast' }],
        },
      ],
    })
    return
  }

  if (request.method === 'POST' && url.pathname === '/api/session') {
    const body = await readBody(request)
    const id = `oc-${crypto.randomBytes(6).toString('hex')}`
    sessions.set(id, {
      title: body.title || '',
      created: Date.now(),
      directory: body.location?.directory || directory,
    })
    broadcast(createdEvent(id, body.title || ''))
    sendJSON(response, 200, { data: sessionInfo(id) })
    return
  }

  const sessionMatch = /^\/api\/session\/([^/]+)(\/[a-z]+)?$/.exec(url.pathname)
  if (sessionMatch) {
    const id = decodeURIComponent(sessionMatch[1])
    const action = sessionMatch[2] || ''
    // The native message log is read from disk, so a session created by another
    // server process answers here too — exactly like the real server.
    if (request.method === 'GET' && action === '/message') {
      sendJSON(response, 200, { data: readMessages(id) })
      return
    }
    if (!sessions.has(id)) {
      sendJSON(response, 404, { _tag: 'not_found', message: 'session not found' })
      return
    }
    if (request.method === 'GET' && action === '') {
      sendJSON(response, 200, { data: sessionInfo(id) })
      return
    }
    if (request.method === 'POST' && action === '/model') {
      await readBody(request)
      sendJSON(response, 200, {})
      return
    }
    if (request.method === 'POST' && action === '/prompt') {
      const body = await readBody(request)
      const text = body.text || ''
      // Re-announce the session so a stream that connected after creation still
      // learns the session id, then start the turn.
      broadcast(createdEvent(id, sessions.get(id)?.title || ''))
      broadcast(executionEvent(id, 'started'))
      recordMessage(id, { type: 'user', text })
      if (text.includes('__e2e_hold__')) {
        // Keep the turn running until the workbench interrupts it, so the stop
        // action can be observed deterministically.
        pending.set(id, text)
      } else {
        for (const event of promptEvents(id, text)) broadcast(event)
        broadcast(executionEvent(id, 'succeeded'))
        // Matches the real shape: assistant entries carry content blocks, and
        // a reasoning block the workbench must skip on replay.
        recordMessage(id, {
          type: 'assistant',
          agent: 'build',
          content: [
            { type: 'reasoning', text: 'internal reasoning is not conversation' },
            { type: 'text', text: `opencode reply: ${text}` },
          ],
        })
      }
      sendJSON(response, 200, {})
      return
    }
    // Interrupt ends only the named session's current turn.
    if (request.method === 'POST' && action === '/interrupt') {
      pending.delete(id)
      broadcast(executionEvent(id, 'interrupted'))
      sendJSON(response, 200, {})
      return
    }
  }

  sendJSON(response, 404, { _tag: 'not_found', message: `no route for ${request.method} ${url.pathname}` })
})

// serviceFilePath is where the real opencode publishes its machine-wide
// registration; the platform reads it and never writes it.
function serviceFilePath() {
  const stateRoot = process.env.XDG_STATE_HOME || path.join(os.homedir(), '.local', 'state')
  return path.join(stateRoot, 'opencode', 'service.json')
}

let publishedRegistration = ''

// publishRegistration writes the file a real `opencode serve --service` writes,
// including the generated credential a client needs to authenticate.
function publishRegistration(url) {
  const file = serviceFilePath()
  fs.mkdirSync(path.dirname(file), { recursive: true })
  fs.writeFileSync(file, JSON.stringify({ id: serviceId, version, url, pid: process.pid, password }))
  publishedRegistration = file
}

// retractRegistration removes only our own registration: a newer service may
// have replaced us, and stealing its file would be a lie.
function retractRegistration() {
  if (!publishedRegistration) return
  try {
    if (JSON.parse(fs.readFileSync(publishedRegistration, 'utf8')).id === serviceId) {
      fs.rmSync(publishedRegistration, { force: true })
    }
  } catch {
    // Nothing to retract.
  }
}

process.on('exit', retractRegistration)
for (const signal of ['SIGTERM', 'SIGINT']) {
  process.on(signal, () => {
    retractRegistration()
    process.exit(0)
  })
}

server.listen(port, host, () => {
  const url = `http://${host}:${port}`
  if (serviceMode) publishRegistration(url)
  process.stderr.write(`mock opencode listening on ${url}${serviceMode ? ' (service mode)' : ''}\n`)
})
